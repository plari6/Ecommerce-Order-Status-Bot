# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=            # @BotFather -> /newbot
STAFF_CHAT_ID=                 # team group: add the bot, send /whoami there, paste the id (e.g. -1001234567890)
# ADMIN_USER_IDS=              # Telegram user ids allowed to approve/reject returns (empty = anyone in the staff group)
# TELEGRAM_WEBHOOK_SECRET=     # webhook mode (`serve` + `set-webhook`); any long random string

# ---------- Shopify (Settings > Apps and sales channels > Develop apps > Create app) ----------
SHOPIFY_SHOP=                  # "your-store" for your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=          # Admin API token (shpat_...), scopes: read_orders, write_orders
SHOPIFY_API_VERSION=2025-10
# SHOPIFY_WEBHOOK_SECRET=      # the app's API secret key (verifies fulfillment webhooks)
# SHOPIFY_WRITE_BACK=true      # tag + note the order when a return is requested
# SHOPIFY_RETURN_TAG=return-requested

# ---------- Store profile ----------
BUSINESS_FILE=examples/business.json   # name, support hours, carriers, shipping times, return policy, FAQs

# ---------- Security ----------
VERIFY_MAX_ATTEMPTS=5          # wrong email/phone attempts before a lock
VERIFY_LOCK_MINUTES=30
LINK_DAYS=30                   # how long a verified order stays linked to a chat

# ---------- Delivery updates ----------
SHIPMENT_POLL_MINUTES=0        # >0: also poll subscribed orders (if you don't use Shopify webhooks)
ALERT_WEBHOOK_URL=             # optional: every return event as JSON (n8n, Make, Zapier, helpdesk)

# ---------- Server (webhook mode) ----------
PORT=3000
PUBLIC_URL=                    # https://your-host (for set-webhook / shopify-webhooks)
API_KEY=                       # x-api-key for /api/returns
# DATA_DIR=./data

# ---------- AI (multi-model fallback: models without a key are skipped) ----------
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GROQ_API_KEY=                  # https://console.groq.com/keys
NVIDIA_API_KEY=                # https://build.nvidia.com
OPENROUTER_API_KEY=            # https://openrouter.ai/keys
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3-flash-preview,groq:llama-3.3-70b-versatile
AI_TIMEOUT_MS=10000
AI_TOTAL_BUDGET_MS=20000
AI_HEDGE_MS=5000
# AI_DISABLED=false            # true = keyword rules + FAQ matching only
